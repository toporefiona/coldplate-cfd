FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     simpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         2000;

deltaT          1;

writeControl    timeStep;

writeInterval   200;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    temperature
    {
        type            scalarTransport;
        libs            ( solverFunctionObjects );
        field           T;
        D               1.44e-07;
        bounded01       false;
        fvOptions
        {
            batteryHeat
            {
                type            scalarSemiImplicitSource;
                selectionMode   cellZone;
                cellZone        channels;
                volumeMode      specific;
                injectionRateSuSp
                {
                    T               ( 0.304 0 );
                }
            }
        }
        writeControl    writeTime;
    }
}


